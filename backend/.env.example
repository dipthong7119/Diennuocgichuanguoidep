# ============================================================
# Sao chép file này thành ".env" và điền API Key của bạn
# Copy this file to ".env" and fill in your API Key
# ============================================================

# --- Chọn AI Provider ---
# Đặt "gemini" hoặc "openai"
AI_PROVIDER=gemini

# --- Google Gemini API Key (miễn phí tại https://aistudio.google.com) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- OpenAI API Key (trả phí tại https://platform.openai.com) ---
OPENAI_API_KEY=your_openai_api_key_here

# --- Model name (tùy chỉnh nếu cần) ---
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_SEARCH_MODEL=gemini-3.5-flash-lite
# Enable only if this project tier supports Search grounding; unavailable for Gemini Flash-Lite Free tier.
GEMINI_ENABLE_GOOGLE_SEARCH=false
OPENAI_MODEL=gpt-4o-mini

# --- SMS nhắc nợ hóa đơn quá hạn từ 3 tháng (Twilio, tùy chọn) ---
# Chỉ gửi khi SMS_ENABLED=true và đã điền đủ 3 biến Twilio bên dưới.
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
